{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shurokkhalink-bd",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "previews": {},
}
